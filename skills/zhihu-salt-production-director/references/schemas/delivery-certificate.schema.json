{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","run_id","story_id","review_id","issued_at","final_manuscript","full_story_audit","event_chain_head","certificate_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string","minLength": 1},
    "story_id": {"type": "string","minLength": 1},
    "review_id": {"type": "string","minLength": 1},
    "issued_at": {"type": "string","format": "date-time"},
    "final_manuscript": {
      "type": "object","additionalProperties": false,"required": ["artifact_id","sha256"],
      "properties": {"artifact_id": {"type": "string"},"sha256": {"type": "string","pattern": "^[a-f0-9]{64}$"}}
    },
    "full_story_audit": {
      "type": "object","additionalProperties": false,"required": ["artifact_id","sha256"],
      "properties": {"artifact_id": {"type": "string"},"sha256": {"type": "string","pattern": "^[a-f0-9]{64}$"}}
    },
    "event_chain_head": {"type": "string","pattern": "^[a-f0-9]{64}$"},
    "certificate_sha256": {"type": "string","pattern": "^[a-f0-9]{64}$"}
  }
}
